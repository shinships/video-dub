# Cấu hình đọc theo thứ tự: keychain (API key lưu qua màn hình Cài đặt) -> settings.json
# trong thư mục dữ liệu -> tệp .env này -> mặc định. Nghĩa là thứ bạn bấm lưu trong app sẽ
# THẮNG các biến dưới đây; .env vẫn là cách cấu hình cho CLI, script và CI.
# API key nên đặt qua Cài đặt (vào keychain của hệ điều hành) thay vì ghi ra file này.

# Gemini API Key (Google AI Studio / Google AI Pro). Hỗ trợ nhiều key phân tách bằng
# dấu phẩy (vd: key1,key2) để tự động luân phiên (round-robin) và đổi key ngay khi chạm quota.
GEMINI_API_KEY=
# Model Gemini cho bước DỊCH (Google AI Studio hoặc Vertex AI).
VIDEO_DUB_GEMINI_MODEL=gemini-3.8-flash

# DeepSeek API Key (OpenAI-compatible). Hỗ trợ nhiều key phân tách bằng dấu phẩy (key1,key2)
# để tự động luân phiên và đổi key ngay khi chạm quota.
DEEPSEEK_API_KEY=
# Model DeepSeek cho bước DỊCH (mặc định: deepseek-v4-pro; có thể đổi thành deepseek-chat)
VIDEO_DUB_DEEPSEEK_MODEL=deepseek-v4-pro
# Endpoint DeepSeek (mặc định: https://api.deepseek.com/chat/completions)
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Engine dịch: "auto" (mặc định: ưu tiên theo key có sẵn) | "gemini" | "deepseek"
VIDEO_DUB_TRANSLATE_ENGINE=auto

# Hoặc Google Cloud / Vertex AI (nếu không dùng GEMINI_API_KEY)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=global
# Chỉ cần khi STT chạy bằng Google (VIDEO_DUB_STT_ENGINE=google).
VIDEO_DUB_GCS_BUCKET=your-stt-bucket

# Tạo giọng (TTS): chỉ còn vieneu (local, miễn phí, cần cài backend/requirements-tts-local.txt).
# Vbee và Gemini TTS đã bị gỡ — bước tạo giọng không gọi cloud, không tốn tiền API.
VIDEO_DUB_TTS_ENGINE=vieneu
# Giọng preset VieNeu (v3turbo có 23 giọng: Adam, Minh Đức, Phạm Tuyên, Thái Sơn, Xuân Vĩnh,
# Trúc Ly, Mai Anh, Đức Trí, Mỹ Duyên, Anh Khôi, Minh Quân, Mạnh Dũng...); để trống dùng giọng
# mặc định (Adam). Đặt sai tên -> backend báo lỗi ngay khi bắt đầu xử lý job.
VIDEO_DUB_VIENEU_VOICE=
# File wav 3-5 giây để nhân bản giọng; nếu đặt sẽ ưu tiên hơn VIDEO_DUB_VIENEU_VOICE.
VIDEO_DUB_VIENEU_REF_AUDIO=
# cpu (mặc định, an toàn) | cuda. VieNeu tự dò CUDA của torch (cài cho Demucs) và có
# thể đụng cuDNN thiếu symbol tuỳ máy — chỉ đổi cuda nếu đã xác nhận ổn định.
VIDEO_DUB_VIENEU_DEVICE=cpu

# --- Lồng tiếng 2 giọng (nam/nữ) ---
# Bật tự dò giới tính người nói theo cao độ (F0) trên vocals.wav rồi gán giọng riêng cho mỗi
# đoạn. Mặc định tắt (1 giọng như cũ). Bật riêng từng job qua công tắc lúc upload, cờ CLI
# --multi-speaker, hoặc PATCH /api/jobs/{id} {"multi_speaker": true}.
VIDEO_DUB_MULTI_SPEAKER=false
# Ngưỡng Hz phân nam/nữ (F0 dưới -> nam, bằng/trên -> nữ). Mặc định 165 hợp phần lớn giọng.
VIDEO_DUB_GENDER_F0_THRESHOLD=165
# Giọng theo giới tính khi bật multi_speaker. Giọng NAM để trống thì kế thừa cấu hình 1-giọng
# ở trên (VIENEU_VOICE / VIENEU_REF_AUDIO) nên thường chỉ cần khai thêm giọng NỮ.
VIDEO_DUB_VIENEU_VOICE_MALE=
VIDEO_DUB_VIENEU_REF_AUDIO_MALE=
VIDEO_DUB_VIENEU_VOICE_FEMALE=
VIDEO_DUB_VIENEU_REF_AUDIO_FEMALE=

# Nhận dạng giọng nói (STT): whisper (local, mặc định) | google (STT V2 batch qua GCS)
VIDEO_DUB_STT_ENGINE=whisper
VIDEO_DUB_WHISPER_MODEL=medium
VIDEO_DUB_WHISPER_COMPUTE=int8

# Tách thoại/nền: htdemucs (mặc định) | htdemucs_ft (sạch hơn, chậm hơn)
VIDEO_DUB_DEMUCS_MODEL=htdemucs
# Số lần shift khi tách (0 = nhanh; 2-5 = sạch hơn, chậm hơn)
VIDEO_DUB_DEMUCS_SHIFTS=0

# true: chạy UI/API bằng dữ liệu mô phỏng, không gọi Cloud.
# false/để trống: tự dùng pipeline thật khi đủ FFmpeg + Cloud config.
VIDEO_DUB_DEMO_MODE=auto

# Số đoạn TTS tạo song song lúc export. VieNeu chạy local -> tăng theo sức CPU/GPU của máy.
VIDEO_DUB_TTS_WORKERS=2

# Tỉ giá quy token ra VNĐ cho bảng chi phí trên UI. Chi phí được ĐO THẬT từ số token nhà
# cung cấp trả về (lưu trong cột jobs.cost), không phải ước lượng. Giá mỗi model nằm ở
# MODEL_PRICING_USD_PER_M trong backend/app/pipeline.py — nhớ cập nhật khi nhà cung cấp
# đổi giá (Gemini 3.8 Flash tăng gấp đôi từ 2027-01-01).
VIDEO_DUB_USD_TO_VND=26000

# --- Thông báo tự động qua Telegram (dùng chung bot với ebook-shortform) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ID topic nếu gửi vào supergroup chia forum topic (vd 3)
TELEGRAM_TOPIC_ID=

# --- Duby Bot (Chuyên tải YouTube & Lồng tiếng tự động qua Telegram) ---
TELEGRAM_DUB_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Tự upload video đã lồng tiếng vào một topic sau khi file local đã lưu thành công.
VIDEO_DUB_TELEGRAM_CHAT_ID=
VIDEO_DUB_TELEGRAM_TOPIC_ID=

# Thư mục lưu video thành phẩm mặc định cho web/CLI/tools.
VIDEO_DUB_OUTPUT_DIR=
# Alias tương thích cho watch_folder.
AUTODUB_OUTPUT_DIR=

# Thư mục dữ liệu (DB, video, job). CHỈ đọc được từ env — settings.json nằm bên trong chính nó.
VIDEO_DUB_DATA_DIR=
# Đặt false để không dùng keychain của hệ điều hành (test dùng cờ này).
VIDEO_DUB_USE_KEYCHAIN=true
# Token truy cập API cục bộ. Để trống thì backend tự sinh và lưu ở <data_dir>/api-token (0600).
# Chỉ đặt tay khi cần truyền sẵn cho tiến trình khác (vd bản đóng gói Tauri).
VIDEO_DUB_API_TOKEN=
# Thời lượng video tối đa (phút). Đổi được trong Cài đặt.
VIDEO_DUB_MAX_DURATION_MINUTES=240
