#!/usr/bin/env bash
# Click đúp để kích hoạt lồng tiếng chạy ngầm (tự tắt cửa sổ, xong báo Telegram)
launchctl start com.mktmda.videodub-daily

clear
echo "============================================================"
echo "🚀 ĐÃ KÍCH HOẠT TIẾN TRÌNH LỒNG TIẾNG CHẠY NGẦM THÀNH CÔNG!"
echo "📁 Đang quét thư mục: ~/Movies/AutoDub"
echo "📬 Kết quả sẽ được gửi tự động qua Telegram."
echo "============================================================"
echo ""
echo "Cửa sổ này sẽ tự động đóng sau 3 giây..."
sleep 3
